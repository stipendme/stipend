STIPEND_HOST=staging.example.com
TLS_EMAIL=admin@example.com
# Server-side RPC (route handlers, worker). Needs getProgramAccounts: use a keyed endpoint.
RPC_URL=https://api.mainnet-beta.solana.com
# Browser RPC, inlined into the bundle at build time. Public is fine for staging.
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# Comma-separated wallets allowed into /admin.
ADMIN_WALLETS=

# --- network selection ---------------------------------------------------------
# mainnet-beta (default) or devnet. Phantom's "Testnet mode" talks to Solana DEVNET, so phone testing = devnet.
NETWORK=mainnet-beta
# For devnet: REGISTRY_PATH=/repo/config/registry.devnet.json KEYS_DIR=/repo/keys/devnet FAUCET_KEY=/repo/keys/devnet/faucet.json
REGISTRY_PATH=/repo/config/registry.json
KEYS_DIR=/repo/keys
FAUCET_KEY=
# separate DB per network, e.g. /repo/data/devnet.db
DB_PATH=/repo/data/stipend.db
# worker loop interval in seconds (demo epochs fire on their own schedule from the registry)
CRON_INTERVAL_SEC=300
# Public origin for token metadata image URLs (defaults to https://<registry brand domain>). Set on staging.
PUBLIC_ORIGIN=

# ---- deploy/.env.local (git-ignored): used by deploy/sync.sh and deploy/prod.sh on your machine, not by the containers ----
# STIPEND_SSH_HOST=user@staging.example.com
# STIPEND_SSH_PORT=22
# STIPEND_REMOTE_DIR=stipend
# STIPEND_PROD_HOST=forge@203.0.113.10
# STIPEND_PROD_URL=http://203.0.113.10/
# STIPEND_PROD_HOSTNAME=stipend.my
# FORGE_API_HOST=user@machine-holding-the-forge-token
# FORGE_API_SSH_PORT=22
# FORGE_TOKEN_FILE=~/forge-token
# FORGE_ORG=your-forge-org
# FORGE_SERVER_ID=123456

# RPC used by the browser (wallet transactions, balances). Use a keyed endpoint that allows your domain.
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com
# RPC used by route handlers on the server.
RPC_URL=https://api.mainnet-beta.solana.com
# Comma-separated wallet addresses allowed into /admin (also exposed to the client for the gate).
ADMIN_WALLETS=
NEXT_PUBLIC_ADMIN_WALLETS=
# SQLite written by the epoch worker. Defaults to ../../data/stipend.db
DB_PATH=
# Override the registry (defaults to ../../config/registry.json). Use fixtures/registry.json for a local demo.
REGISTRY_PATH=
